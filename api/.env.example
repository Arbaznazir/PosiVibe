# Ultra-Robust Content Moderation System - Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key for advanced content moderation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Perspective API Key for toxicity detection
# Get your API key from: https://developers.perspectiveapi.com/s/
GOOGLE_PERSPECTIVE_API_KEY=your_google_perspective_api_key_here

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=social_db

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Server Configuration
PORT=8800
NODE_ENV=development

# Content Moderation Settings
CONTENT_MODERATION_ENABLED=true
ZERO_TOLERANCE_MODE=true
LOG_VIOLATIONS=true
AUTO_DELETE_INAPPROPRIATE_FILES=true

# Toxicity Thresholds (0.0 - 1.0)
TOXICITY_SOFT_THRESHOLD=0.3
TOXICITY_MEDIUM_THRESHOLD=0.5
TOXICITY_HARD_THRESHOLD=0.7
TOXICITY_CRITICAL_THRESHOLD=0.9

# NSFW Image Detection Thresholds (0.0 - 1.0)
NSFW_THRESHOLD=0.6
SEXY_THRESHOLD=0.4

# Admin Dashboard Settings
ADMIN_PANEL_ENABLED=true
VIOLATION_ALERTS_ENABLED=true

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,bmp,mp4,avi,mov,wmv,pdf,txt

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for violation notifications)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password 