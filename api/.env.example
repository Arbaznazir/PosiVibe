# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_API_KEY=your_api_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Google Perspective API
GOOGLE_PERSPECTIVE_API_KEY=your_perspective_api_key

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=social_db

# MongoDB Configuration
MONGODB_URI=your_mongodb_uri

# JWT Configuration
JWT_SECRET=your_jwt_secret

# Server Configuration
PORT=8800
NODE_ENV=development

# Content Moderation Settings
CONTENT_MODERATION_ENABLED=true
ZERO_TOLERANCE_MODE=true
LOG_VIOLATIONS=true
AUTO_DELETE_INAPPROPRIATE_FILES=true

# Toxicity Thresholds
TOXICITY_SOFT_THRESHOLD=0.3
TOXICITY_MEDIUM_THRESHOLD=0.5
TOXICITY_HARD_THRESHOLD=0.7
TOXICITY_CRITICAL_THRESHOLD=0.9

# NSFW Thresholds
NSFW_THRESHOLD=0.6
NSFW_SOFT_THRESHOLD=0.3
NSFW_MEDIUM_THRESHOLD=0.5
NSFW_HARD_THRESHOLD=0.7
NSFW_CRITICAL_THRESHOLD=0.9

# Video Content Moderation Settings
VIDEO_MAX_DURATION=300
VIDEO_FRAME_INTERVAL=2
VIDEO_MAX_FRAMES=10
VIDEO_CONSENSUS_THRESHOLD=0.3
SEXY_THRESHOLD=0.4

# Admin Settings
ADMIN_PANEL_ENABLED=true
VIOLATION_ALERTS_ENABLED=true

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,bmp,mp4,avi,mov,wmv,pdf,txt

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Settings
EMAIL_ENABLED=false 